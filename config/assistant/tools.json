    {
      "type": "function",
      "function": {
        "name": "draft_award",
        "description": "准备本次加分草稿，也可修改当前待确认的同一笔加分。普通行为加分值默认本次，无需追问一次还是常用。行为和本次分值明确时直接传name和points，不需要已有规则或先查规则；指定按已有规则加分时才用其真实itemId。新行为的缺失分值不能沿用上一笔。name可删明确赘字，保留原意、条件和否定；reason只填明确给出的本次原因。有影响分值或行为的歧义时先澄清。确认前不记账。",
        "parameters": {
          "type": "object",
          "properties": {
            "itemId": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            "name": {
              "type": "string",
              "maxLength": 120
            },
            "points": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "本笔明确的整数分值。新行为后没有积分单位、又可解释成生活动作的同音表达，先确认含义和分值；不能因上一笔是一分就猜本笔也是一分。"
            },
            "reason": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [],
          "additionalProperties": false
        }
      }
    },

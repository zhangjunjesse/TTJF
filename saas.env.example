# Example values only. Copy to .env.saas.production and replace them before deployment.
NODE_ENV=production
PUBLIC_ORIGIN=https://your-domain.example
SQLITE_FILE=./data/ttjf.sqlite
MAIL_FROM=小小向前 <no-reply@your-domain.example>
SMTP_HOST=your-smtp-host.example
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_ACCOUNT
SMTP_PASS=YOUR_SMTP_PASSWORD
# Operator-provisioned account. Only a missing account is created; existing
# passwords and verification state are never reset by a restart.
INITIAL_ACCOUNT_EMAIL=391504704@qq.com
INITIAL_ACCOUNT_PASSWORD=
SAAS_CLEANUP_INTERVAL_MS=300000
SAAS_CLEANUP_BATCH_SIZE=200
# Optional container deployment only; direct Node startup needs none of these.
# Pin SAAS_NODE_IMAGE to a reviewed Node 22 image digest for a production release.
SAAS_NODE_IMAGE=node:22-alpine
SAAS_PUBLISHED_PORT=4180
SAAS_BRIDGE_SUBNET=172.30.80.0/28
SAAS_PROXY_ADDRESS=172.30.80.1
# Optional AI provider configuration; omit to retain the local command interpreter.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini

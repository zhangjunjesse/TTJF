# Runtime only: no test tools, private data, environment files or historical exports.
ARG NODE_IMAGE=node:22-alpine
FROM ${NODE_IMAGE}
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --chown=node:node saas-server.cjs assistant-service.cjs assistant-chat.cjs assistant-tools.cjs assistant.js model.js ./
COPY --chown=node:node config/assistant ./config/assistant
COPY --chown=node:node saas ./saas
COPY --chown=node:node tools/saas-data.cjs ./tools/saas-data.cjs
COPY --chown=node:node tools/saas-db.cjs ./tools/saas-db.cjs
COPY --chown=node:node index.html styles.css app.js runtime.js saas-client.js saas.css pet.js pet.css farm-ui.js farm.css farm-scene.js world-ui.js farm-world.css home-points.js home-points.css assistant-panel.js assistant-panel.css voice-input.js voice-pcm-worklet.js manifest.webmanifest ./
COPY --chown=node:node assets ./assets
RUN mkdir -p /app/data && chown node:node /app/data
ENV SQLITE_FILE=/app/data/ttjf.sqlite
VOLUME /app/data
USER node
EXPOSE 4180
STOPSIGNAL SIGTERM
CMD ["node", "saas-server.cjs"]
